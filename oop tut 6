#include <iostream>
using namespace std;
class Complex {
float real, imag;

public:
    Complex(float r= 0 , float i= 0) {
        real = r;
        imag = i;
    }

    
    Complex operator*(const Complex& c) {
        Complex result;
        result.real = (real * c.real) - (imag * c.imag);
        result.imag = (real * c.imag) + (imag * c.real);
        return result;
    }

    void display() {
        cout << real << " + " << imag << "i" << endl;
    }
};

int main()
{
 Complex c1(2,6);
 Complex c2(5,9);
 Complex c3 = c1*(c2);
 cout << "Enter first complex number:\n";
 c1.display();
 cout << "\nEnter second complex number:\n";
 c2.display();
 cout << "Product: ";
 c3.display();


 return 0;
}
