#include <iostream>
using namespace std;

namespace First
{
    int a = 10;

    void display()
    {
        cout << "First namespace: " << a << endl;
    }
}

namespace Second
{
    int a = 20;

    void display()
    {
        cout << "Second namespace: " << a << endl;
    }
}

int main()
{
    First::display();
    Second::display();

    return 0;
}
