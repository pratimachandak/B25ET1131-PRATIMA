#include <iostream>
using namespace std;

class Transport
{
public:
    virtual void fare()
    {
        cout << "Transport fare" << endl;
    }
};

class Bus : public Transport
{
public:
    void fare()
    {
        cout << "Bus fare is Rs. 50" << endl;
    }
};

class Train : public Transport
{
public:
    void fare()
    {
        cout << "Train fare is Rs. 100" << endl;
    }
};

int main()
{
    Transport *ptr;
    Bus b;
    Train t;

    ptr = &b;
    ptr->fare();

    ptr = &t;
    ptr->fare();

    return 0;
}
