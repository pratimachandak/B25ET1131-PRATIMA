#include <iostream>
using namespace std;
void swap(int &a, int &b)
{
    int temp = a;
    a = b;
    b = temp;
}

void swap(float &a, float &b)
{
    float temp = a;
    a = b;
    b = temp;
}

int main()
{
    int x = 10, y = 20;
    float p = 1.5f, q = 2.5f;

    cout << "Before swapping integers: " << x << " " << y << endl;
    swap(x, y);
    cout << "After swapping integers:  " << x << " " << y << endl;

    cout << "\nBefore swapping floats: " << p << " " << q << endl;
    swap(p, q);
    cout << "After swapping floats:  " << p << " " << q << endl;

    return 0;
}
