#include <iostream>
using namespace std;

class Basic
{
protected:
    int id;
    float salary;

public:
    void getBasic()
    {
        cout << "Enter employee ID: ";
        cin >> id;
        cout << "Enter salary: ";
        cin >> salary;
    }
};

class Leave
{
protected:
    int leaves;

public:
    void getLeave()
    {
        cout << "Enter leave information: ";
        cin >> leaves;
    }
};

class Employee : public Basic, public Leave
{
public:
    void Display()
    {
        cout << "\nEmployee ID: " << id;
        cout << "\nSalary: " << salary;
        cout << "\nLeaves: " << leaves;
    }
};

int main()
{
    Employee e;
    e.getBasic();
    e.getLeave();
    e.Display();

    return 0;
}
