#include <iostream>
#include <string>
using namespace std;

class String
{
    string str;

public:
    String(string s)
    {
        str = s;
    }

    void Accept()
    {
        cout << "Enter a string: ";
        cin >> str;
    }

    void Display()
    {
        cout << "String is: " << str;
    }
};

int main()
{
    String s("Hello");

    s.Accept();
    s.Display();

    return 0;
}
